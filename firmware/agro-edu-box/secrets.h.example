// Salin file ini menjadi secrets.h di folder yang sama, lalu isi.
// secrets.h TIDAK ikut masuk ke GitHub (sudah terdaftar di .gitignore),
// karena berisi kata sandi WiFi sekolah dan token alat.

#pragma once

// ─── WiFi sekolah ───────────────────────────────────────────────────────
// ESP32 hanya bisa memakai WiFi 2,4 GHz. Kalau router sekolah memisahkan
// 2,4 GHz dan 5 GHz dengan nama berbeda, pilih yang 2,4 GHz.
#define WIFI_SSID      "NAMA_WIFI_SEKOLAH"
#define WIFI_PASSWORD  "PASSWORD_WIFI"

// ─── Website Agro-Edu Box ───────────────────────────────────────────────
// Alamat penerima data. Biarkan apa adanya kecuali alamat websitenya berubah.
#define INGEST_URL     "https://agro-edu-box.vercel.app/api/iot/ingest"

// Harus sama persis dengan IOT_INGEST_TOKEN di Vercel
// (Settings > Environment Variables) dan di .env.local.
#define INGEST_TOKEN   "ISI_TOKEN_DARI_VERCEL"
