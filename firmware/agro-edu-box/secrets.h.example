// Salin file ini menjadi secrets.h di folder yang sama, lalu isi.
// secrets.h TIDAK ikut masuk ke GitHub (sudah terdaftar di .gitignore),
// karena berisi kata sandi WiFi sekolah dan kata sandi broker MQTT.

#pragma once

// ─── WiFi sekolah ───────────────────────────────────────────────────────
// ESP32 hanya bisa memakai WiFi 2,4 GHz. Kalau router sekolah memisahkan
// 2,4 GHz dan 5 GHz dengan nama berbeda, pilih yang 2,4 GHz.
#define WIFI_SSID      "NAMA_WIFI_SEKOLAH"
#define WIFI_PASSWORD  "PASSWORD_WIFI"

// ─── Broker MQTT (EMQX Serverless) ──────────────────────────────────────
// Dapat dari EMQX Cloud > Cluster > Connection: alamat broker dan port TLS.
#define MQTT_HOST      "xxxxxxxx.ala.asia-southeast1.emqxsl.com"
#define MQTT_PORT      8883

// Dibuat di EMQX Cloud > Authentication, bukan email akun EMQX-mu.
#define MQTT_USERNAME  "agro-esp32"
#define MQTT_PASSWORD  "ISI_KATA_SANDI_MQTT"

// ─── Topik ──────────────────────────────────────────────────────────────
// Harus sama persis dengan yang diisi di aturan webhook EMQX.
#define MQTT_TOPIC_DATA    "agroedubox/kebun/data"
#define MQTT_TOPIC_STATUS  "agroedubox/kebun/status"
