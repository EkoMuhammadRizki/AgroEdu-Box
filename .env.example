# Salin menjadi .env.local lalu isi. Di Vercel: Settings > Environment Variables.
# Semuanya hanya dipakai di server, JANGAN diberi awalan NEXT_PUBLIC_.

# Supabase Dashboard > Project Settings > Data API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Dashboard > Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Kunci tanda tangan sesi guru, minimal 32 karakter acak. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GURU_SESSION_SECRET=

# Token alat IoT. Tanpa ini, produksi MENOLAK semua data sensor agar tidak ada
# angka palsu yang masuk. Isi nilai yang sama di firmware (secrets.h).
# Buat dengan:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
IOT_INGEST_TOKEN=

# Opsional: alat dianggap mati bila diam selama ini (detik). Bawaan 120.
IOT_OFFLINE_AFTER_SECONDS=120
